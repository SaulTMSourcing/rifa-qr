# ============================================================
# Backend - Configuracion de entorno
# ============================================================
# COMO USAR:
#   1. Copia este archivo a `.env` en la misma carpeta:
#        cp .env.example .env          (Linux / macOS / Git Bash)
#        copy .env.example .env        (CMD de Windows)
#   2. Rellena los valores reales.
#   3. NUNCA subas el `.env` a Git: contiene credenciales.
#      El .gitignore de la raiz ya lo bloquea.
#
# El servidor valida al arrancar que existan DB_HOST, DB_PORT,
# DB_USER, DB_PASSWORD y DB_NAME. Si falta alguna, aborta con
# process.exit(1) antes de escuchar peticiones (fail-fast).
# Ver backend/src/config/db.js
# ============================================================


# ------------------------------------------------------------
# Base de datos MySQL (Hostinger)  --  REQUERIDAS
# ------------------------------------------------------------
# DB_HOST: para conexion remota es la IP o dominio que da el
#   panel de Hostinger. Si el backend corre en el mismo hosting,
#   suele ser "localhost".
#   Importante: para conexion remota hay que autorizar tu IP en
#   el panel -> Bases de datos -> MySQL Remoto. Si no, el arranque
#   falla con ETIMEDOUT / ENOTFOUND.
DB_HOST=localhost

# Puerto estandar de MySQL.
DB_PORT=3306

# Usuario de la base. Hostinger le antepone un prefijo numerico,
# por ejemplo: u123456789_rifa
DB_USER=u000000000_usuario

# Contrasena del usuario de MySQL.
DB_PASSWORD=cambia_esta_contrasena

# Nombre de la base. Hostinger tambien le pone prefijo,
# por ejemplo: u123456789_rifa_qr
DB_NAME=u000000000_rifa_qr


# ------------------------------------------------------------
# Pool de conexiones  --  OPCIONALES (tienen default en codigo)
# ------------------------------------------------------------
# Maximo de conexiones simultaneas en el pool. Subirlo solo si
# el hosting lo permite; Hostinger suele limitar por plan.
DB_CONNECTION_LIMIT=10

# Milisegundos de espera al abrir conexion. Un valor holgado
# ayuda cuando la base es remota y la red del evento es lenta.
DB_CONNECT_TIMEOUT=10000


# ------------------------------------------------------------
# Servidor HTTP  --  OPCIONALES
# ------------------------------------------------------------
# Puerto donde escucha Express.
PORT=3001

# Origen permitido por CORS. En desarrollo es el dev server de
# Vite. En produccion cambiar al dominio real del frontend,
# por ejemplo: https://rifa.tudominio.com
CORS_ORIGIN=http://localhost:5173

# development | production
NODE_ENV=development

# ------------------------------------------------------------
# Ventana de registro
# ------------------------------------------------------------
# El sorteo se hace DESPUES de cerrar los registros, sobre la lista
# real de participantes. Por eso hay que poder cerrar la puerta en
# un momento concreto: quien entre despues del sorteo no estaria en
# la lista de la que salieron los ganadores.
#
# Para cerrar el viernes: pon false y reinicia la aplicacion.
#   - La app muestra "El registro ya cerro"
#   - El endpoint responde 403 registro_cerrado
#   - Quien ya se registro SIGUE viendo su numero
#
# El servidor imprime al arrancar si quedo abierto o cerrado.
#
# Si la variable no existe, el registro esta ABIERTO: cerrar tiene
# que ser un acto deliberado, nunca un descuido de configuracion.
REGISTRO_ABIERTO=true


# ------------------------------------------------------------
# Rate limiting de POST /api/registrar  --  OPCIONALES
# ------------------------------------------------------------
# Solo aplica al endpoint de registro; /api/health queda libre.
# Se pueden ajustar el dia del evento sin tocar codigo.
#
# Ventana en milisegundos (default 15 min).
RATE_LIMIT_WINDOW_MS=900000

# Maximo de peticiones por IP dentro de la ventana (default 300).
#
# CUIDADO: el limite es POR IP, y en una convencion TODA la sala
# sale por la misma IP publica del WiFi. No se reparte por persona,
# se consume entre todas juntas. Con el valor anterior de 20, el
# asistente numero 21 recibia 429 y nadie mas podia registrarse.
#
# Regla practica: al menos 2 veces la asistencia esperada.
#   150 asistentes -> 300
#   400 asistentes -> 800
#
# RATE_LIMIT_MAX=0 desactiva el limite por completo. Es la salida de
# emergencia si el dia del evento resulta que el proxy no reenvia la
# IP real y todo el trafico se ve como una sola IP.
#
# El valor efectivo se imprime al arrancar el servidor.
RATE_LIMIT_MAX=300
