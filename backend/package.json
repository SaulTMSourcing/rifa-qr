{
  "name": "rifa-qr-backend",
  "version": "1.0.0",
  "description": "Backend API para sistema de registro y rifa por códigos QR",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sandbox:setup": "node scripts/sandbox-setup.js",
    "sandbox:check": "node scripts/sandbox-check-admin.js",
    "sandbox:check-vacio": "node scripts/sandbox-check-vacio.js"
  },
  "keywords": [
    "rifa",
    "qr",
    "express",
    "mysql"
  ],
  "author": "Saul Trejo Garcia",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "mysql2": "^3.22.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "vitest": "^3.2.4"
  }
}
