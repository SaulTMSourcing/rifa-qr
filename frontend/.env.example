# ============================================================
# Frontend - Configuracion de entorno (Vite)
# ============================================================
# Las variables deben empezar con VITE_ para que Vite las
# exponga al navegador. NO meter secretos aqui: estas variables
# terminan visibles en el bundle JS del cliente.
# ============================================================

# URL base del backend. En desarrollo apunta al Node local.
# En produccion se cambia a la URL real del API en Hostinger.
VITE_API_URL=http://localhost:3001

# ------------------------------------------------------------
# Aviso de privacidad  --  OBLIGATORIO ANTES DE PRODUCCION
# ------------------------------------------------------------
# URL publica del aviso de privacidad de CLICK. El formulario la
# usa en el checkbox de consentimiento, que es obligatorio para
# poder registrarse.
#
# Si se deja vacia, el texto "Aviso de Privacidad" aparece sin
# enlace: se sigue exigiendo el consentimiento, pero el usuario no
# tiene donde leer el aviso. La LFPDPPP obliga a que pueda
# consultarlo antes de entregar sus datos, asi que hay que
# definirla antes de abrir el registro.
VITE_AVISO_PRIVACIDAD_URL=
